<Window
    x:Class="Auralita.App.MainWindow"
    x:Name="RootWindow"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:Auralita.App"
    xmlns:vm="clr-namespace:Auralita.App"
    Title="Auralita Music Player"
    Width="1280"
    Height="840"
    MinWidth="1000"
    MinHeight="700"
    WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <app:BoolToBrushConverter x:Key="BoolToBrushConverter" />
    <app:BoolToStringConverter x:Key="BoolToStringConverter" />
    <app:BoolToInverseConverter x:Key="BoolToInverseConverter" />
    <app:IntToBoolConverter x:Key="IntToBoolConverter" />
    <app:StringToBoolConverter x:Key="StringToBoolConverter" />
    <app:IntToTrackCountConverter x:Key="IntToTrackCountConverter" />
    <app:TrackDetailConverter x:Key="TrackDetailConverter" />
    <app:DoubleToWidthConverter x:Key="DoubleToWidthConverter" />
    <app:RepeatModeToBrushConverter x:Key="RepeatModeToBrushConverter" />
    <app:RepeatModeToPathConverter x:Key="RepeatModeToPathConverter" />
    <app:RepeatModeToTooltipConverter x:Key="RepeatModeToTooltipConverter" />
  </Window.Resources>

  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="_File">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem
                Header="Add Music…"
                Gesture="Meta+O"
                Click="OnMenuOpenClick" />
            <NativeMenuItemSeparator />
            <NativeMenuItem
                Header="Quit Auralita"
                Gesture="Meta+Q"
                Click="OnMenuQuitClick" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="_Plex">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Connect to Plex…" Click="OnMenuPlexClick" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="_Playback">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem
                Header="Play Selected Track"
                Gesture="Meta+P"
                Click="OnMenuPlayClick" />
            <NativeMenuItem Header="Stop Playback" Click="OnMenuStopClick" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="_View">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Toggle Queue" Gesture="Meta+Shift+Q" Click="OnToggleQueueClick" />
            <NativeMenuItem Header="Toggle Lyrics" Gesture="Meta+L" Click="OnToggleLyricsClick" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <!-- Ambient Glow Background Layer -->
  <Grid>
    <Border x:Name="AmbientGlowLayer"
            IsHitTestVisible="False"
            ZIndex="-1">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="{Binding AmbientPrimaryColor}" />
          <GradientStop Offset="0.5" Color="{Binding AmbientSecondaryColor}" />
          <GradientStop Offset="1" Color="#17151B" />
        </LinearGradientBrush>
      </Border.Background>
      <Border.OpacityMask>
        <RadialGradientBrush Center="50%,50%" RadiusX="0.5" RadiusY="0.5">
          <GradientStop Offset="0" Color="#00000000" />
          <GradientStop Offset="0.3" Color="#1A000000" />
          <GradientStop Offset="1" Color="#33000000" />
        </RadialGradientBrush>
      </Border.OpacityMask>
    </Border>

    <!-- Main Three-Zone Layout -->
    <Grid ColumnDefinitions="240,*,340" RowDefinitions="Auto,*,Auto">
      <!-- ========== LEFT SIDEBAR ========== -->
      <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
              Classes="sidebar"
              Classes.glass="True">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="0">
          <!-- Brand & Search -->
          <StackPanel Margin="16,16,16,8" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Viewbox Width="28" Height="28" Stretch="Uniform">
                <Canvas Width="64" Height="64">
                  <Path Data="M 25,5 L 39,5 L 49,23 L 32,60 L 15,23 Z" Fill="#65459B" Stroke="#35234F" StrokeThickness="1.5" />
                  <Path Data="M 25,5 L 32,23 L 15,23 Z" Fill="#B49ADA" />
                  <Path Data="M 39,5 L 32,23 L 49,23 Z" Fill="#8B6ABD" />
                  <Path Data="M 15,23 L 32,23 L 32,60 Z" Fill="#7756AA" />
                  <Path Data="M 32,23 L 49,23 L 32,60 Z" Fill="#50367F" />
                  <Path Data="M 28,12 L 32,9 L 36,12 L 32,16 Z" Fill="#E9A08B" />
                </Canvas>
              </Viewbox>
              <TextBlock FontSize="20" FontWeight="Bold" Text="Auralita" />
            </StackPanel>
            <TextBox x:Name="SearchBox"
                     Classes="glass"
                     PlaceholderText="Filter library &amp; queue…"
                     Text="{Binding FilterText, Mode=TwoWay}"
                     Padding="12,8"
                     CornerRadius="10" />
          </StackPanel>

          <!-- Library Navigation -->
          <StackPanel Margin="8,4,8,8" Spacing="2">
            <TextBlock Classes="eyebrow" Margin="12,0,0,6" Text="LIBRARY" />
            <Button Classes="sidebar-item"
                    Command="{Binding SidebarSectionCommand}"
                    CommandParameter="{x:Static vm:SidebarSection.Queue}"
                    ToolTip.Tip="Queue">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Width="20" Height="20" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M 3,3 L 12,3 L 12,10 L 3,10 Z M 15,3 L 24,3 L 24,10 L 15,10 Z M 3,13 L 12,13 L 12,20 L 3,20 Z M 15,13 L 24,13 L 24,20 L 15,20 Z" />
                <TextBlock Text="Queue" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="sidebar-item"
                    Command="{Binding SidebarSectionCommand}"
                    CommandParameter="{x:Static vm:SidebarSection.Tracks}"
                    ToolTip.Tip="Tracks">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Width="20" Height="20" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M 12,2 L 22,8 L 22,22 L 12,28 L 2,22 L 2,8 Z M 12,6 L 18,10 L 18,22 L 12,26 L 6,22 L 6,10 Z" />
                <TextBlock Text="Tracks" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="sidebar-item"
                    Command="{Binding SidebarSectionCommand}"
                    CommandParameter="{x:Static vm:SidebarSection.Albums}"
                    ToolTip.Tip="Albums">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Width="20" Height="20" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M 4,4 L 20,4 L 20,24 L 4,24 Z M 6,6 L 18,6 L 18,14 L 6,14 Z" />
                <TextBlock Text="Albums" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="sidebar-item"
                    Command="{Binding SidebarSectionCommand}"
                    CommandParameter="{x:Static vm:SidebarSection.Artists}"
                    ToolTip.Tip="Artists">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Width="20" Height="20" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M 12,4 C 16.4,4 20,7.6 20,12 C 20,16.4 16.4,20 12,20 C 7.6,20 4,16.4 4,12 C 4,7.6 7.6,4 12,4 Z M 12,2 C 17.5,2 22,6.5 22,12 C 22,17.5 17.5,22 12,22 C 6.5,22 2,17.5 2,12 C 2,6.5 6.5,2 12,2 Z M 12,6 C 9.8,6 8,7.8 8,10 C 8,12.2 9.8,14 12,14 C 14.2,14 16,12.2 16,10 C 16,7.8 14.2,6 12,6 Z" />
                <TextBlock Text="Artists" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Source Filters -->
          <StackPanel Margin="8,12,8,8" Spacing="2">
            <TextBlock Classes="eyebrow" Margin="12,0,0,6" Text="SOURCES" />
            <Button Classes="sidebar-item"
                    Command="{Binding SourceFilterCommand}"
                    CommandParameter="{x:Static vm:SourceFilter.All}"
                    ToolTip.Tip="All Sources">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Width="20" Height="20" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M 12,2 L 22,8 L 22,22 L 12,28 L 2,22 L 2,8 Z M 12,6 L 18,10 L 18,22 L 12,26 L 6,22 L 6,10 Z" />
                <TextBlock Text="All Sources" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="sidebar-item"
                    Command="{Binding SourceFilterCommand}"
                    CommandParameter="{x:Static vm:SourceFilter.Plex}"
                    ToolTip.Tip="Plex">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Width="20" Height="20" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M 12,2 C 6.5,2 2,6.5 2,12 C 2,17.5 6.5,22 12,22 C 17.5,22 22,17.5 22,12 C 22,6.5 17.5,2 12,2 Z M 12,4 C 16.4,4 20,7.6 20,12 C 20,16.4 16.4,20 12,20 C 7.6,20 4,16.4 4,12 C 4,7.6 7.6,4 12,4 Z M 8,12 L 11,15 L 16,10" />
                <TextBlock Text="Plex" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="sidebar-item"
                    Command="{Binding SourceFilterCommand}"
                    CommandParameter="{x:Static vm:SourceFilter.Local}"
                    ToolTip.Tip="Local Audio">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Width="20" Height="20" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M 4,4 L 20,4 L 20,24 L 4,24 Z M 6,6 L 18,6 L 18,14 L 6,14 Z M 12,18 L 12,22 M 8,18 L 8,22 M 16,18 L 16,22" />
                <TextBlock Text="Local Audio" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Active Source Status & Actions -->
          <Border Grid.Row="3" Margin="8,8,8,12" Padding="12"
                  Background="{StaticResource GlassBackgroundBrush}"
                  BorderBrush="{StaticResource GlassBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="12">
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="8" Height="8" CornerRadius="4"
                        Background="{Binding PlexConnected, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=Success}"
                        ToolTip.Tip="Plex Connected" />
                <TextBlock Classes="caption" Text="Plex Connected" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" HorizontalAlignment="Stretch"
                        Command="{Binding ConnectPlexCommand}"
                        Content="Connect Plex" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="quiet" HorizontalAlignment="Stretch"
                        Command="{Binding AddFilesCommand}"
                        Content="Open Files" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Version Info -->
          <TextBlock Grid.Row="4" Classes="caption"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,16"
                     Text="v0.1.0" />
        </Grid>
      </Border>

      <!-- ========== TOP TRANSPORT BAR ========== -->
      <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
              Classes="glass glass-thin"
              Margin="0,0,0,0"
              Padding="8,6"
              VerticalAlignment="Top">
        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="24">
          <!-- Left: Window Controls (macOS style) -->
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
            <Button Classes="icon" ToolTip.Tip="Close" Click="OnCloseClick">
              <Path Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource TextSecondaryBrush}"
                    Data="M 4,4 L 12,12 M 12,4 L 4,12" />
            </Button>
            <Button Classes="icon" ToolTip.Tip="Minimize" Click="OnMinimizeClick">
              <Path Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource TextSecondaryBrush}"
                    Data="M 4,8 L 12,8" />
            </Button>
            <Button Classes="icon" ToolTip.Tip="Zoom" Click="OnZoomClick">
              <Path Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource TextSecondaryBrush}"
                    Data="M 4,4 L 12,4 L 12,12 L 4,12 Z M 6,6 L 10,6 L 10,10 L 6,10 Z" />
            </Button>
          </StackPanel>

          <!-- Center: Playback Cluster + LCD Now Playing Pill -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" VerticalAlignment="Center">
            <!-- Shuffle -->
            <Button Classes="icon transport"
                    Command="{Binding ShuffleCommand}"
                    IsEnabled="{Binding QueueCount, Converter={StaticResource IntToBoolConverter}}"
                    ToolTip.Tip="Shuffle">
              <Path Width="16" Height="16" Stretch="Uniform"
                    Fill="{Binding IsShuffle, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=Shuffle}"
                    Data="M 2,2 L 8,2 L 8,8 L 2,8 Z M 10,10 L 16,10 L 16,16 L 10,16 Z M 2,10 L 8,10 L 8,16 L 2,16 Z M 10,2 L 16,2 L 16,8 L 10,8 Z M 5,5 L 11,11 M 11,5 L 5,11" />
            </Button>

            <!-- Previous -->
            <Button Classes="transport"
                    Command="{Binding PreviousCommand}"
                    ToolTip.Tip="Previous">
              <Path Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource TextPrimaryBrush}"
                    Data="M 10,2 L 18,8 L 10,14 Z M 2,2 L 8,8 L 2,14 Z" />
            </Button>

            <!-- Play/Pause Toggle -->
            <Button Classes="transport transport-play"
                    Command="{Binding TogglePlayPauseCommand}"
                    ToolTip.Tip="{Binding IsPlaying, Converter={StaticResource BoolToStringConverter}, ConverterParameter=PlayPause}">
              <Path Width="20" Height="20" Stretch="Uniform"
                    Fill="{Binding IsPlaying, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=PlayPause}"
                    Data="{Binding IsPlaying, Converter={StaticResource BoolToStringConverter}, ConverterParameter=PlayPausePath}" />
            </Button>

            <!-- Next -->
            <Button Classes="transport"
                    Command="{Binding NextCommand}"
                    ToolTip.Tip="Next">
              <Path Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource TextPrimaryBrush}"
                    Data="M 2,2 L 10,8 L 2,14 Z M 14,2 L 22,8 L 14,14 Z" />
            </Button>

            <!-- Repeat -->
            <Button Classes="icon transport"
                    Command="{Binding RepeatCommand}"
                    ToolTip.Tip="{Binding RepeatMode, Converter={StaticResource RepeatModeToTooltipConverter}}">
              <Path Width="16" Height="16" Stretch="Uniform"
                    Fill="{Binding RepeatMode, Converter={StaticResource RepeatModeToBrushConverter}}"
                    Data="{Binding RepeatMode, Converter={StaticResource RepeatModeToPathConverter}}" />
            </Button>
          </StackPanel>

          <!-- Right: LCD Now Playing Pill + Utilities -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" VerticalAlignment="Center" Margin="0,0,12,0">
            <!-- LCD Now Playing Pill -->
            <Border Classes="lcd-pill" MinWidth="280" MaxWidth="400">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                <!-- Track Artwork -->
                <Border Width="36" Height="36" CornerRadius="6" ClipToBounds="True"
                        Background="{StaticResource SurfaceRaisedBrush}">
                  <Image Source="{Binding ActiveTrackArtwork}" Stretch="UniformToFill" />
                </Border>

                <!-- Track Info -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" MinWidth="0">
                  <StackPanel Spacing="1" MinWidth="0">
                    <TextBlock Text="{Binding ActiveTrackTitle}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="220" />
                    <TextBlock Text="{Binding ActiveTrackArtist, Converter={StaticResource TrackDetailConverter}, ConverterParameter=Artist}"
                               Classes="caption"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="220" />
                  </StackPanel>
                </StackPanel>

                <!-- Scrub Bar (integrated in LCD) -->
                <Grid Grid.Column="2" MinWidth="120" MaxWidth="200" VerticalAlignment="Center">
                  <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                      <TextBlock Text="{Binding ElapsedTimeText}" Classes="mono lcd" FontSize="10" />
                      <Border Height="3" VerticalAlignment="Center"
                              Background="{StaticResource PlayerTrackBrush}"
                              CornerRadius="1.5">
                        <Border Width="{Binding ProgressFraction, Converter={StaticResource DoubleToWidthConverter}, ConverterParameter=180}"
                                Height="3" HorizontalAlignment="Left"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="1.5" />
                      </Border>
                      <TextBlock Text="{Binding RemainingTimeText}" Classes="mono lcd" FontSize="10" />
                    </Grid>
                  </Grid>
                </Grid>

                <!-- Favorite / More -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Classes="icon" ToolTip.Tip="Add to favorites" Width="28" Height="28" Padding="0">
                    <Path Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource TextSecondaryBrush}"
                          Data="M 12,2 L 15,8 L 22,8 L 17,12 L 19,19 L 12,15 L 5,19 L 7,12 L 2,8 L 9,8 Z" />
                  </Button>
                  <Button Classes="icon" ToolTip.Tip="More options" Width="28" Height="28" Padding="0">
                    <Path Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource TextSecondaryBrush}"
                          Data="M 6,6 L 6,10 M 12,6 L 12,10 M 18,6 L 18,10" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Volume -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Classes="icon"
                      Command="{Binding MuteCommand}"
                      ToolTip.Tip="{Binding IsMuted, Converter={StaticResource BoolToStringConverter}, ConverterParameter=MutePath}">
                <Path Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource TextPrimaryBrush}"
                      Data="{Binding IsMuted, Converter={StaticResource BoolToStringConverter}, ConverterParameter=MutePath}" />
              </Button>
              <Slider Minimum="0" Maximum="1"
                      Value="{Binding Volume, Mode=TwoWay}"
                      Width="100"
                      IsEnabled="{Binding IsMuted, Converter={StaticResource BoolToInverseConverter}}" />
            </StackPanel>

            <!-- Lyrics Toggle -->
            <Button Classes="icon"
                    Command="{Binding ToggleLyricsCommand}"
                    ToolTip.Tip="Lyrics"
                    IsEnabled="{Binding HasActiveTrack}">
              <Path Width="18" Height="18" Stretch="Uniform"
                    Fill="{Binding IsLyricsVisible, Converter={StaticResource BoolToBrushConverter}}"
                    Data="M 4,4 L 20,4 L 20,12 L 4,12 Z M 4,16 L 20,16 L 20,24 L 4,24 Z M 8,7 L 16,7 M 8,11 L 12,11 M 8,19 L 16,19 M 8,23 L 12,23" />
            </Button>

            <!-- Queue Drawer Toggle -->
            <Button Classes="icon"
                    Command="{Binding ToggleQueueCommand}"
                    ToolTip.Tip="Playing Next"
                    IsEnabled="{Binding QueueCount, Converter={StaticResource IntToBoolConverter}}">
              <Path Width="18" Height="18" Stretch="Uniform"
                    Fill="{Binding IsQueueVisible, Converter={StaticResource BoolToBrushConverter}}"
                    Data="M 3,3 L 12,3 L 12,10 L 3,10 Z M 15,3 L 24,3 L 24,10 L 15,10 Z M 3,13 L 12,13 L 12,20 L 3,20 Z M 15,13 L 24,13 L 24,20 L 15,20 Z" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ========== MAIN CONTENT CANVAS ========== -->
      <Border Grid.Row="1" Grid.Column="1"
              Margin="16,16,8,16"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="14"
              ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">
          <!-- Section Header -->
          <Grid ColumnDefinitions="*,Auto" Margin="20,16,20,8">
            <StackPanel Spacing="4">
              <TextBlock x:Name="SectionTitle" FontSize="22" FontWeight="SemiBold" Text="Queue" />
              <TextBlock Classes="caption" Text="{Binding QueueCount, Converter={StaticResource IntToTrackCountConverter}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="1" VerticalAlignment="Center">
              <Button Classes="quiet" ToolTip.Tip="Sort" Content="Sort" />
              <Button Classes="quiet" ToolTip.Tip="Filter" Content="Filter" />
            </StackPanel>
          </Grid>

          <!-- Column Headers (for Tracks view) -->
          <Grid x:Name="ColumnHeaders"
                ColumnDefinitions="40,*,140,100,60"
                Margin="20,0,20,8"
                IsVisible="False">
            <TextBlock Classes="caption" Text="#" />
            <TextBlock Classes="caption" Text="TITLE" />
            <TextBlock Classes="caption" Text="ARTIST" Grid.Column="1" />
            <TextBlock Classes="caption" Text="ALBUM" Grid.Column="2" />
            <TextBlock Classes="caption" Text="TIME" Grid.Column="3" HorizontalAlignment="Right" />
            <TextBlock Classes="caption" Text="" Grid.Column="4" />
          </Grid>

          <!-- Track List / Queue -->
          <ScrollViewer Grid.Row="2" Margin="0,0,0,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ListBox x:Name="TrackList"
                     ItemsSource="{Binding }"
                     SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,0,0,8">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="app:QueueTrackViewModel">
                  <Grid ColumnDefinitions="40,48,*,140,100,60,40" ColumnSpacing="12" Margin="16,6">
                    <!-- Track Number / Playing Indicator -->
                    <Grid Grid.Column="0" Width="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock x:Name="TrackNumber" Classes="mono caption" HorizontalAlignment="Center" Text="{Binding TrackNumber}" />
                      <StackPanel x:Name="PlayingIndicator" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" IsVisible="False">
                        <Border Width="3" Height="12" Background="{StaticResource AccentBrush}" CornerRadius="1.5" />
                        <Border Width="3" Height="8" Background="{StaticResource AccentBrush}" CornerRadius="1.5" />
                        <Border Width="3" Height="16" Background="{StaticResource AccentBrush}" CornerRadius="1.5" />
                      </StackPanel>
                    </Grid>

                    <!-- Artwork -->
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="6" ClipToBounds="True"
                            Background="{StaticResource SurfaceRaisedBrush}">
                      <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
                    </Border>

                    <!-- Title & Artist -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" MinWidth="0">
                      <TextBlock FontWeight="SemiBold" FontSize="14"
                                 Text="{Binding Title}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="caption"
                                 Text="{Binding Artist}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Album -->
                    <TextBlock Grid.Column="3" Classes="caption"
                               VerticalAlignment="Center"
                               Text="{Binding Album, Converter={StaticResource TrackDetailConverter}, ConverterParameter=Album}"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Duration -->
                    <TextBlock Grid.Column="4" Classes="mono caption"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Text="{Binding DurationText}" />

                    <!-- Quality Badge -->
                    <Border Grid.Column="5" Classes="badge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsVisible="{Binding QualityLabel, Converter={StaticResource StringToBoolConverter}}">
                      <TextBlock Classes="caption" FontSize="11" FontWeight="SemiBold"
                                 Text="{Binding QualityLabel}" />
                    </Border>

                    <!-- Actions -->
                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="False">
                      <Button Classes="icon" ToolTip.Tip="Play Next" Width="28" Height="28" Padding="0">
                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource TextSecondaryBrush}"
                              Data="M 4,4 L 12,8 L 4,12 Z M 14,4 L 22,8 L 14,12 Z" />
                      </Button>
                      <Button Classes="icon" ToolTip.Tip="Remove" Width="28" Height="28" Padding="0"
                              Command="{Binding DataContext.RemoveCommand, ElementName=RootWindow}"
                              CommandParameter="{Binding }">
                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource TextSecondaryBrush}"
                              Data="M 4,4 L 12,12 M 12,4 L 4,12" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0" />
                  <Setter Property="Template">
                    <ControlTemplate>
                      <Border Name="PART_Border"
                              CornerRadius="8"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center"
                                          Padding="0" />
                      </Border>
                    </ControlTemplate>
                  </Setter>
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ Border#PART_Border">
                  <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ Border#PART_Border">
                  <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </Style>
              </ListBox.Styles>
            </ListBox>
          </ScrollViewer>

          <!-- Empty State -->
          <StackPanel x:Name="EmptyStatePanel"
                      Grid.Row="2"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="16"
                      IsVisible="False">
            <Viewbox Width="64" Height="64" Stretch="Uniform">
              <Canvas Width="64" Height="64">
                <Path Data="M 25,5 L 39,5 L 49,23 L 32,60 L 15,23 Z" Fill="#65459B" />
                <Path Data="M 25,5 L 32,23 L 15,23 Z" Fill="#B49ADA" />
                <Path Data="M 39,5 L 32,23 L 49,23 Z" Fill="#8B6ABD" />
                <Path Data="M 15,23 L 32,23 L 32,60 Z" Fill="#7756AA" />
                <Path Data="M 32,23 L 49,23 L 32,60 Z" Fill="#50367F" />
              </Canvas>
            </Viewbox>
            <TextBlock FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Text="Nothing to play" />
            <TextBlock Classes="muted"  TextWrapping="Wrap" MaxWidth="300"
                       Text="Add local audio files or connect to Plex to fill your queue." />
            <Button Classes="accent" HorizontalAlignment="Center" Content="Choose Music"
                    Command="{Binding AddFilesCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ========== RIGHT PANEL: NOW PLAYING / PLAYING NEXT / LYRICS ========== -->
      <Border Grid.Row="1" Grid.Column="2"
              Margin="8,16,16,16"
              Classes="glass"
              Padding="0">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">
          <!-- Segmented Control -->
          <Border Margin="12,12,12,0" Padding="4"
                  Background="{StaticResource SurfaceBrush}"
                  CornerRadius="10"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button x:Name="NowPlayingTab"
                      Classes="quiet"
                      Padding="16,8"
                      CornerRadius="8"
                      Command="{Binding ToggleQueueCommand}"
                      Content="Now Playing"
                      FontWeight="SemiBold"
                      FontSize="12" />
              <Button x:Name="PlayingNextTab"
                      Classes="quiet"
                      Padding="16,8"
                      CornerRadius="8"
                      Command="{Binding ToggleQueueCommand}"
                      Content="Playing Next"
                      FontWeight="SemiBold"
                      FontSize="12" />
              <Button x:Name="LyricsTab"
                      Classes="quiet"
                      Padding="16,8"
                      CornerRadius="8"
                      Command="{Binding ToggleLyricsCommand}"
                      Content="Lyrics"
                      FontWeight="SemiBold"
                      FontSize="12"
                      IsEnabled="{Binding HasActiveTrack}" />
            </StackPanel>
          </Border>

          <!-- Panel Content -->
          <Grid Grid.Row="1" Margin="12,12,12,0">
            <!-- Now Playing View -->
            <StackPanel x:Name="NowPlayingPanel" Spacing="16">
              <!-- Artwork Card -->
              <Border Classes="nowplaying-card" Padding="24">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16" HorizontalAlignment="Center">
                  <Border Width="280" Height="280" CornerRadius="12" ClipToBounds="True"
                          Background="{StaticResource SurfaceRaisedBrush}"
                          BoxShadow="0 16 48 -16 {StaticResource GlassShadowBrush}">
                    <Image Source="{Binding ActiveTrackArtwork}" Stretch="UniformToFill" />
                  </Border>

                  <StackPanel Spacing="8" HorizontalAlignment="Center" >
                    <TextBlock Text="{Binding ActiveTrackTitle}"
                               FontSize="28"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="320" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                      <Button Classes="quiet"
                              Content="{Binding ActiveTrackArtist, Converter={StaticResource TrackDetailConverter}, ConverterParameter=Artist}"
                              FontSize="14"
                              Foreground="{StaticResource TextSecondaryBrush}" />
                      <TextBlock Classes="caption" Text="·" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                      <Button Classes="quiet"
                              Content="{Binding ActiveTrackAlbum, Converter={StaticResource TrackDetailConverter}, ConverterParameter=Album}"
                              FontSize="14"
                              Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <Border Classes="badge"
                            IsVisible="{Binding ActiveTrackQuality, Converter={StaticResource StringToBoolConverter}}">
                      <TextBlock Classes="caption" FontSize="11" FontWeight="SemiBold"
                                 Text="{Binding ActiveTrackQuality}" />
                    </Border>
                    <Border Classes="badge success"
                            IsVisible="{Binding IsPlaying}">
                      <TextBlock Classes="caption" FontSize="11" FontWeight="SemiBold"
                                 Text="Playing" />
                    </Border>
                    <Border Classes="badge warning"
                            IsVisible="{Binding IsPaused}">
                      <TextBlock Classes="caption" FontSize="11" FontWeight="SemiBold"
                                 Text="Paused" />
                    </Border>
                  </StackPanel>

                  <!-- Playback Controls in Now Playing -->
                  <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
                    <Button Classes="transport"
                            Command="{Binding ShuffleCommand}"
                            ToolTip.Tip="Shuffle">
                      <Path Width="20" Height="20" Stretch="Uniform"
                            Fill="{Binding IsShuffle, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=Shuffle}"
                            Data="M 2,2 L 8,2 L 8,8 L 2,8 Z M 10,10 L 16,10 L 16,16 L 10,16 Z M 2,10 L 8,10 L 8,16 L 2,16 Z M 10,2 L 16,2 L 16,8 L 10,8 Z M 5,5 L 11,11 M 11,5 L 5,11" />
                    </Button>
                    <Button Classes="transport"
                            Command="{Binding PreviousCommand}"
                            ToolTip.Tip="Previous">
                      <Path Width="22" Height="22" Stretch="Uniform" Fill="{StaticResource TextPrimaryBrush}"
                            Data="M 10,2 L 18,8 L 10,14 Z M 2,2 L 8,8 L 2,14 Z" />
                    </Button>
                    <Button Classes="transport transport-play"
                            Command="{Binding TogglePlayPauseCommand}"
                            ToolTip.Tip="{Binding IsPlaying, Converter={StaticResource BoolToStringConverter}, ConverterParameter=PlayPause}">
                      <Path Width="28" Height="28" Stretch="Uniform"
                            Fill="{Binding IsPlaying, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=PlayPause}"
                            Data="{Binding IsPlaying, Converter={StaticResource BoolToStringConverter}, ConverterParameter=PlayPausePathLarge}" />
                    </Button>
                    <Button Classes="transport"
                            Command="{Binding NextCommand}"
                            ToolTip.Tip="Next">
                      <Path Width="22" Height="22" Stretch="Uniform" Fill="{StaticResource TextPrimaryBrush}"
                            Data="M 2,2 L 10,8 L 2,14 Z M 14,2 L 22,8 L 14,14 Z" />
                    </Button>
                    <Button Classes="transport"
                            Command="{Binding RepeatCommand}"
                            ToolTip.Tip="{Binding RepeatMode, Converter={StaticResource RepeatModeToTooltipConverter}}">
                      <Path Width="20" Height="20" Stretch="Uniform"
                            Fill="{Binding RepeatMode, Converter={StaticResource RepeatModeToBrushConverter}}"
                            Data="{Binding RepeatMode, Converter={StaticResource RepeatModeToPathConverter}}" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Progress Bar -->
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                <TextBlock Text="{Binding ElapsedTimeText}" Classes="mono lcd" FontSize="12" />
                <Border Height="4" VerticalAlignment="Center"
                        Background="{StaticResource PlayerTrackBrush}"
                        CornerRadius="2">
                  <Border Width="{Binding ProgressFraction, Converter={StaticResource DoubleToWidthConverter}, ConverterParameter=300}"
                          Height="4" HorizontalAlignment="Left"
                          Background="{StaticResource AccentBrush}"
                          CornerRadius="2" />
                </Border>
                <TextBlock Text="{Binding RemainingTimeText}" Classes="mono lcd" FontSize="12" />
              </Grid>
            </StackPanel>

            <!-- Playing Next View -->
            <ScrollViewer x:Name="PlayingNextPanel"
                          IsVisible="False"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="0">
                <TextBlock Classes="eyebrow" Margin="4,0,0,8" Text="PLAYING NEXT" />
                <ListBox x:Name="UpNextList"
                         ItemsSource="{Binding }"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="app:QueueTrackViewModel">
                      <Grid ColumnDefinitions="40,44,*,Auto,40" ColumnSpacing="12" Margin="16,4">
                        <TextBlock Grid.Column="0" Classes="mono caption" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="{Binding QueuePosition}" />
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="6" ClipToBounds="True"
                                Background="{StaticResource SurfaceRaisedBrush}">
                          <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1" MinWidth="0">
                          <TextBlock FontWeight="SemiBold" FontSize="13"
                                     Text="{Binding Title}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="caption"
                                     Text="{Binding Artist}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Classes="mono caption"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Text="{Binding DurationText}" />
                        <Button Grid.Column="4" Classes="icon" ToolTip.Tip="Remove" Width="28" Height="28" Padding="0"
                                Command="{Binding DataContext.RemoveCommand, ElementName=RootWindow}"
                                CommandParameter="{Binding }">
                          <Path Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource TextTertiaryBrush}"
                                Data="M 4,4 L 12,12 M 12,4 L 4,12" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button x:Name="ClearUpNextButton"
                        Classes="quiet"
                        Margin="16,12,0,0"
                        HorizontalAlignment="Left"
                        Content="Clear"
                        IsVisible="False" />
              </StackPanel>
            </ScrollViewer>

            <!-- Lyrics View -->
            <ScrollViewer x:Name="LyricsPanel"
                          IsVisible="False"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="16">
                <TextBlock Classes="eyebrow" Margin="4,0,0,8" Text="LYRICS" />
                <TextBlock x:Name="LyricsText"
                           FontSize="15"
                           LineHeight="26"
                           
                           TextWrapping="Wrap"
                           Text="No lyrics available for this track." />
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- Status Bar -->
          <Border Grid.Row="2" Margin="12,12,12,12" Padding="12,8"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10">
            <TextBlock x:Name="StatusText" Classes="caption" Text="{Binding StatusText}" TextWrapping="Wrap" />
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>

<Window
    x:Class="Auralita.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:Auralita.App"
    Title="Auralita"
    Width="1120"
    Height="780"
    MinWidth="800"
    MinHeight="620"
    WindowStartupLocation="CenterScreen">
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="_File">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem
                Header="Add Music…"
                Gesture="Meta+O"
                Click="OnMenuOpenClick" />
            <NativeMenuItemSeparator />
            <NativeMenuItem
                Header="Quit Auralita"
                Gesture="Meta+Q"
                Click="OnMenuQuitClick" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="_Plex">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Connect to Plex…" Click="OnMenuPlexClick" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="_Playback">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem
                Header="Play Selected Track"
                Gesture="Meta+P"
                Click="OnMenuPlayClick" />
            <NativeMenuItem Header="Stop Playback" Click="OnMenuStopClick" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Grid Margin="24" RowDefinitions="Auto,*,Auto" RowSpacing="18">
    <Grid Grid.Row="0" ColumnDefinitions="48,*,Auto,Auto" ColumnSpacing="12">
      <Viewbox Width="44" Height="44" Stretch="Uniform">
        <Canvas Width="64" Height="64">
          <Path
              Data="M 25,5 L 39,5 L 49,23 L 32,60 L 15,23 Z"
              Fill="#65459B"
              Stroke="#35234F"
              StrokeThickness="1.5" />
          <Path Data="M 25,5 L 32,23 L 15,23 Z" Fill="#B49ADA" />
          <Path Data="M 39,5 L 32,23 L 49,23 Z" Fill="#8B6ABD" />
          <Path Data="M 15,23 L 32,23 L 32,60 Z" Fill="#7756AA" />
          <Path Data="M 32,23 L 49,23 L 32,60 Z" Fill="#50367F" />
          <Path Data="M 28,12 L 32,9 L 36,12 L 32,16 Z" Fill="#E9A08B" />
        </Canvas>
      </Viewbox>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
        <TextBlock FontSize="26" FontWeight="Bold" Text="Auralita" />
        <TextBlock Classes="muted" FontSize="12" Text="Your music, in its element." />
      </StackPanel>
      <Button
          x:Name="PlexButton"
          Grid.Column="2"
          VerticalAlignment="Center"
          Content="Connect Plex"
          Click="OnPlexClick" />
      <Button
          x:Name="AddTracksButton"
          Grid.Column="3"
          Classes="accent"
          VerticalAlignment="Center"
          Content="Open files"
          Click="OnAddTracksClick" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,300" ColumnSpacing="16">
      <Border
          Padding="16"
          Background="{StaticResource SurfaceBrush}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="16">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock FontSize="19" FontWeight="SemiBold" Text="Queue" />
              <TextBlock Classes="muted" FontSize="12" Text="Choose a track to start listening." />
            </StackPanel>
            <Border
                Grid.Column="1"
                VerticalAlignment="Center"
                Background="{StaticResource AccentSoftBrush}"
                CornerRadius="12"
                Padding="10,5">
              <TextBlock
                  x:Name="QueueCountText"
                  Classes="mono"
                  FontSize="11"
                  Foreground="{StaticResource AccentBrush}"
                  Text="0 tracks" />
            </Border>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="4">
            <Button
                x:Name="MoveUpButton"
                Classes="quiet"
                Content="Move up"
                Click="OnMoveUpClick"
                ToolTip.Tip="Move the selected track earlier" />
            <Button
                x:Name="MoveDownButton"
                Grid.Column="1"
                Classes="quiet"
                Content="Move down"
                Click="OnMoveDownClick"
                ToolTip.Tip="Move the selected track later" />
            <Button
                x:Name="RemoveButton"
                Grid.Column="2"
                Classes="quiet"
                Content="Remove"
                Click="OnRemoveClick"
                ToolTip.Tip="Remove the selected track from the queue" />
          </Grid>

          <Grid Grid.Row="2" MinHeight="0">
            <ListBox
                x:Name="QueueList"
                Background="Transparent"
                BorderThickness="0"
                SelectionChanged="OnSelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="app:QueueTrackViewModel">
                  <Grid Margin="3,2" ColumnDefinitions="48,*,Auto" ColumnSpacing="11">
                    <Border
                        Width="44"
                        Height="44"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        CornerRadius="8"
                        ClipToBounds="True">
                      <Grid>
                        <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <Canvas Width="64" Height="64">
                            <Path Data="M 25,5 L 39,5 L 49,23 L 32,60 L 15,23 Z" Fill="#65459B" />
                            <Path Data="M 25,5 L 32,23 L 15,23 Z" Fill="#B49ADA" />
                            <Path Data="M 39,5 L 32,23 L 49,23 Z" Fill="#8B6ABD" />
                            <Path Data="M 15,23 L 32,23 L 32,60 Z" Fill="#7756AA" />
                            <Path Data="M 32,23 L 49,23 L 32,60 Z" Fill="#50367F" />
                          </Canvas>
                        </Viewbox>
                        <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                      <TextBlock
                          FontWeight="SemiBold"
                          Text="{Binding Title}"
                          TextTrimming="CharacterEllipsis" />
                      <TextBlock
                          Classes="muted"
                          FontSize="12"
                          Text="{Binding Artist}"
                          TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                      <TextBlock
                          Classes="muted"
                          FontSize="11"
                          HorizontalAlignment="Right"
                          Text="{Binding DurationText}" />
                      <TextBlock
                          Classes="muted"
                          FontSize="11"
                          HorizontalAlignment="Right"
                          MaxWidth="100"
                          Text="{Binding Album}"
                          TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel
                x:Name="EmptyQueuePanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="300"
                Spacing="12">
              <Viewbox Width="48" Height="48" HorizontalAlignment="Center" Stretch="Uniform">
                <Canvas Width="64" Height="64">
                  <Path Data="M 25,5 L 39,5 L 49,23 L 32,60 L 15,23 Z" Fill="#65459B" />
                  <Path Data="M 25,5 L 32,23 L 15,23 Z" Fill="#B49ADA" />
                  <Path Data="M 39,5 L 32,23 L 49,23 Z" Fill="#8B6ABD" />
                  <Path Data="M 15,23 L 32,23 L 32,60 Z" Fill="#7756AA" />
                  <Path Data="M 32,23 L 49,23 L 32,60 Z" Fill="#50367F" />
                </Canvas>
              </Viewbox>
              <TextBlock
                  FontSize="17"
                  FontWeight="SemiBold"
                  HorizontalAlignment="Center"
                  Text="Your queue is empty" />
              <TextBlock
                  Classes="muted"
                  TextAlignment="Center"
                  TextWrapping="Wrap"
                  Text="Open audio files or connect to Plex to add music here." />
              <Button
                  Classes="accent"
                  HorizontalAlignment="Center"
                  Content="Choose music"
                  Click="OnAddTracksClick" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Border
          Grid.Column="1"
          Padding="18"
          Background="{StaticResource SurfaceBrush}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="16">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
          <TextBlock Classes="eyebrow" Text="NOW PLAYING" />
          <Border
              Grid.Row="1"
              MinHeight="220"
              Background="{StaticResource AppBackgroundBrush}"
              CornerRadius="12"
              ClipToBounds="True">
            <Grid>
              <Viewbox Width="96" Height="112" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="64" Height="64">
                  <Path
                      Data="M 25,5 L 39,5 L 49,23 L 32,60 L 15,23 Z"
                      Fill="#65459B"
                      Stroke="#35234F"
                      StrokeThickness="1.5" />
                  <Path Data="M 25,5 L 32,23 L 15,23 Z" Fill="#B49ADA" />
                  <Path Data="M 39,5 L 32,23 L 49,23 Z" Fill="#8B6ABD" />
                  <Path Data="M 15,23 L 32,23 L 32,60 Z" Fill="#7756AA" />
                  <Path Data="M 32,23 L 49,23 L 32,60 Z" Fill="#50367F" />
                  <Path Data="M 28,12 L 32,9 L 36,12 L 32,16 Z" Fill="#E9A08B" />
                </Canvas>
              </Viewbox>
              <Image x:Name="NowPlayingArtwork" Stretch="UniformToFill" />
            </Grid>
          </Border>
          <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock
                x:Name="NowPlayingText"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Nothing playing"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="NowPlayingDetailsText"
                Classes="muted"
                FontSize="12"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="StatusText"
                Classes="eyebrow"
                Margin="0,6,0,0"
                Text="Ready when you are"
                TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border
        Grid.Row="2"
        Padding="16,14"
        Background="{StaticResource SurfaceBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="16">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="7">
        <Grid ColumnDefinitions="*,Auto,*">
          <TextBlock
              Classes="eyebrow"
              VerticalAlignment="Center"
              Text="PLAYER CONTROLS" />
          <StackPanel
              Grid.Column="1"
              Orientation="Horizontal"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Spacing="6">
            <Button
                x:Name="PreviousButton"
                Classes="transport"
                IsEnabled="False"
                ToolTip.Tip="Previous track"
                Click="OnPreviousClick">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Data="M 0,7 L 10,0 L 10,14 Z M 12,0 L 15,0 L 15,14 L 12,14 Z" Fill="{StaticResource TextPrimaryBrush}" />
                <TextBlock FontSize="11" Text="Prev" />
              </StackPanel>
            </Button>
            <Button
                x:Name="PauseButton"
                Classes="transport"
                IsEnabled="False"
                ToolTip.Tip="Pause playback"
                Click="OnPauseClick">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Data="M 1,0 L 5,0 L 5,14 L 1,14 Z M 9,0 L 13,0 L 13,14 L 9,14 Z" Fill="{StaticResource TextPrimaryBrush}" />
                <TextBlock FontSize="11" Text="Pause" />
              </StackPanel>
            </Button>
            <Button
                x:Name="PlayButton"
                Classes="transport transport-play"
                IsEnabled="False"
                ToolTip.Tip="Play selected track"
                Click="OnPlayClick">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Data="M 0,0 L 12,7 L 0,14 Z" Fill="{StaticResource AccentForegroundBrush}" />
                <TextBlock FontSize="11" Text="Play" />
              </StackPanel>
            </Button>
            <Button
                x:Name="StopButton"
                Classes="transport"
                IsEnabled="False"
                ToolTip.Tip="Stop playback"
                Click="OnStopClick">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Data="M 1,1 L 13,1 L 13,13 L 1,13 Z" Fill="{StaticResource TextPrimaryBrush}" />
                <TextBlock FontSize="11" Text="Stop" />
              </StackPanel>
            </Button>
            <Button
                x:Name="NextButton"
                Classes="transport"
                IsEnabled="False"
                ToolTip.Tip="Next track"
                Click="OnNextClick">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Data="M 0,0 L 10,7 L 0,14 Z M 12,0 L 22,7 L 12,14 Z M 24,0 L 27,0 L 27,14 L 24,14 Z" Fill="{StaticResource TextPrimaryBrush}" />
                <TextBlock FontSize="11" Text="Next" />
              </StackPanel>
            </Button>
          </StackPanel>
          <TextBlock
              Grid.Column="2"
              Classes="muted"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              FontSize="11"
              Text="Local audio  ·  Plex" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="44,*,54" ColumnSpacing="10">
          <TextBlock
              x:Name="ElapsedTimeText"
              Classes="mono muted"
              VerticalAlignment="Center"
              FontSize="11"
              Text="00:00" />
          <Grid
              x:Name="ProgressTrack"
              Grid.Column="1"
              Height="24"
              Background="Transparent"
              ClipToBounds="True"
              Cursor="Hand"
              PointerPressed="OnProgressPointerPressed">
            <Border
                Height="5"
                VerticalAlignment="Center"
                Background="{StaticResource PlayerTrackBrush}"
                CornerRadius="3" />
            <Border
                x:Name="ProgressFill"
                Width="0"
                Height="5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{StaticResource AccentBrush}"
                CornerRadius="3" />
          </Grid>
          <TextBlock
              x:Name="RemainingTimeText"
              Grid.Column="2"
              Classes="mono muted"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              FontSize="11"
              Text="--:--" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>

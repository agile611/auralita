<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <RootNamespace>Auralita.App</RootNamespace>
    <MacAudioBridgeArchitecture Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">arm64</MacAudioBridgeArchitecture>
    <MacAudioBridgeArchitecture Condition="'$(RuntimeIdentifier)' == 'osx-x64'">x86_64</MacAudioBridgeArchitecture>
    <MacAudioBridgeArchitecture Condition="'$(MacAudioBridgeArchitecture)' == '' and '$(NETCoreSdkRuntimeIdentifier)' == 'osx-x64'">x86_64</MacAudioBridgeArchitecture>
    <MacAudioBridgeArchitecture Condition="'$(MacAudioBridgeArchitecture)' == ''">arm64</MacAudioBridgeArchitecture>
    <MacAudioBridgePath>$(IntermediateOutputPath)native/libAuralitaAudio.dylib</MacAudioBridgePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Auralita.Core/Auralita.Core.csproj" />
  </ItemGroup>
  <Target
      Name="BuildMacAudioBridge"
      BeforeTargets="PrepareForBuild"
      Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <MakeDir Directories="$(IntermediateOutputPath)native" />
    <Exec Command="xcrun --sdk macosx clang -arch $(MacAudioBridgeArchitecture) -fobjc-arc -dynamiclib -framework AVFoundation -framework CoreMedia -framework Foundation -framework Security -install_name @rpath/libAuralitaAudio.dylib -o &quot;$(MacAudioBridgePath)&quot; &quot;$(MSBuildProjectDirectory)/Native/AuralitaAudio.m&quot;" />
    <ItemGroup>
      <Content
          Include="$(MacAudioBridgePath)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          TargetPath="libAuralitaAudio.dylib" />
    </ItemGroup>
  </Target>
</Project>
